# CloudGuardX local development settings
NODE_ENV=development

# API
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# The Vite dev server proxies /api to http://localhost:3000.
VITE_API_BASE_URL=/api

# Database and cache
DATABASE_URL=postgresql://cloudguardx:cloudguardx_dev_password@localhost:5432/cloudguardx?schema=public
REDIS_URL=redis://localhost:6379

# Auth. Replace these before using any shared environment.
JWT_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_TOKEN_SECRET=replace-with-another-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=604800

# Encryption key for sensitive persisted fields. Local-only example decodes to 32 bytes.
FIELD_ENCRYPTION_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# AWS scanner defaults
AWS_REGION=us-east-1
AWS_STS_ENDPOINT=
LOCALSTACK_ENDPOINT=http://localhost:4566

# Worker
WORKER_ID=cloudguardx-worker-local
SCANNER_WORKER_POLL_ENABLED=true
SCANNER_WORKER_POLL_INTERVAL_MS=5000

# Demo login created by `npm run db:seed`
DEMO_USER_EMAIL=demo@cloudguardx.local
DEMO_USER_PASSWORD=CloudGuardX-Demo-123!
