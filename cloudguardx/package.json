{
  "name": "cloudguardx",
  "version": "0.1.0",
  "private": true,
  "description": "CloudGuardX cloud security posture management platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/shared-types",
    "packages/policy-engine",
    "packages/risk-engine",
    "packages/aws-connectors",
    "packages/ui",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "build": "npm --workspaces --if-present run build",
    "clean": "npm --workspaces --if-present run clean",
    "compose:config": "docker compose config",
    "compose:down": "docker compose down",
    "compose:up": "docker compose up --build",
    "db:generate": "npm run prisma:generate --workspace @cloudguardx/api",
    "db:migrate:dev": "npm run prisma:migrate:dev --workspace @cloudguardx/api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace @cloudguardx/api",
    "db:seed": "npm run prisma:seed --workspace @cloudguardx/api",
    "db:validate": "npm run prisma:validate --workspace @cloudguardx/api",
    "dev:api": "npm run start:dev --workspace @cloudguardx/api",
    "dev:web": "npm run dev --workspace @cloudguardx/web --",
    "dev:worker": "npm run start:dev --workspace @cloudguardx/worker",
    "dev:all": "concurrently --kill-others-on-fail --names \"api,worker,web\" --prefix-colors \"cyan,yellow,magenta\" \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "format": "prettier --write .",
    "lint": "npm --workspaces --if-present run lint",
    "security:audit": "npm audit",
    "start:api": "npm run start --workspace @cloudguardx/api",
    "start:web": "npm run preview --workspace @cloudguardx/web -- --host 0.0.0.0",
    "start:worker": "npm run start --workspace @cloudguardx/worker",
    "test": "npm --workspaces --if-present run test",
    "test:e2e": "npm --workspaces --if-present run test:e2e",
    "typecheck": "npm --workspaces --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.10"
  }
}
