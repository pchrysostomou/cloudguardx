{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": false,
    "moduleResolution": "node",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@cloudguardx/aws-connectors": ["packages/aws-connectors/src"],
      "@cloudguardx/policy-engine": ["packages/policy-engine/src"],
      "@cloudguardx/risk-engine": ["packages/risk-engine/src"],
      "@cloudguardx/shared-types": ["packages/shared-types/src"],
      "@cloudguardx/ui": ["packages/ui/src"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022"
  }
}
