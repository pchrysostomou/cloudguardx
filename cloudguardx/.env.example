# CloudGuardX — local development environment
# Copy this file to .env and fill in any values marked CHANGE_ME.
# Never commit .env to version control.

NODE_ENV=development

# ── API server ─────────────────────────────────────────────────────────────
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:5173

# Origins allowed by the CORS policy (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# The Vite dev server proxies /api → http://localhost:3000, so the relative
# path below works for local dev. Change to the full API URL in production.
VITE_API_BASE_URL=/api

# ── Database & cache ───────────────────────────────────────────────────────
# Matches the postgres service in docker-compose.yml
DATABASE_URL=postgresql://cloudguardx:cloudguardx_dev_password@localhost:5432/cloudguardx?schema=public

REDIS_URL=redis://localhost:6379

# ── Authentication ─────────────────────────────────────────────────────────
# CHANGE_ME: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_TOKEN_SECRET=replace-with-another-32-random-characters

# Token lifetimes (seconds)
ACCESS_TOKEN_TTL_SECONDS=600       # 10 minutes
REFRESH_TOKEN_TTL_SECONDS=604800   # 7 days

# ── Field encryption ───────────────────────────────────────────────────────
# CHANGE_ME in any shared environment. This example decodes to 32 bytes (local only).
FIELD_ENCRYPTION_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ── AWS scanner ────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Override STS endpoint for LocalStack (leave blank for real AWS)
AWS_STS_ENDPOINT=

# LocalStack endpoint — used by the worker in development
LOCALSTACK_ENDPOINT=http://localhost:4566

# ── Scanner worker ─────────────────────────────────────────────────────────
WORKER_ID=cloudguardx-worker-local
SCANNER_WORKER_POLL_ENABLED=true
SCANNER_WORKER_POLL_INTERVAL_MS=5000

# ── Demo seed data ─────────────────────────────────────────────────────────
# Created by `npm run db:seed`. Pre-filled on the web login page.
DEMO_USER_EMAIL=demo@cloudguardx.local
DEMO_USER_PASSWORD=CloudGuardX-Demo-123!
